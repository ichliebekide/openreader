{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenReader",
  "version": "0.1.0",
  "identifier": "org.openreader.OpenReader",
  "build": {
    "beforeDevCommand": "trunk serve",
    "beforeBuildCommand": "trunk build --release",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenReader",
        "url": "index.html",
        "width": 1240,
        "height": 800,
        "minWidth": 1040,
        "minHeight": 660,
        "decorations": false,
        "transparent": false,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "OpenReader Overlay",
        "url": "index.html#/overlay",
        "width": 72,
        "height": 72,
        "minWidth": 72,
        "minHeight": 72,
        "maxWidth": 72,
        "maxHeight": 72,
        "shadow": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libkf6config-bin",
          "pipewire-alsa",
          "libasound2t64 | libasound2"
        ],
        "recommends": [
          "tesseract-ocr",
          "tesseract-ocr-deu"
        ]
      }
    },
    "category": "Utility",
    "shortDescription": "Wayland-first AI TTS reader",
    "longDescription": "OpenReader reads selected text aloud on Linux using a Wayland-first desktop architecture."
  }
}
