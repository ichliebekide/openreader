{
  "name": "openreader",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Wayland-first AI text-to-speech reader for Linux.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "app:dev": "tauri dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "package:linux": "tauri build -- --bundles deb,appimage",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml -p openreader-backend --lib bindings::tests::export_bindings -- --ignored --exact",
    "bindings:check": "cargo test --manifest-path src-tauri/Cargo.toml -p openreader-backend --lib bindings::tests::bindings_are_up_to_date -- --exact",
    "backend": "cargo run --manifest-path src-tauri/Cargo.toml -p openreader-backend"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
