Depends: ${misc:Depends}, ffmpeg, libwebkit2gtk-4.1-0, libasound2t64 | libasound2, pipewire-bin, pipewire-alsa, wl-clipboard, xdg-desktop-portal, xdg-desktop-portal-kde, tesseract-ocr, libkf6config-bin, qdbus-qt6
